{
  "name": "pak-tourism-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:seed:kp-destinations": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/import-kp-destinations.ts",
    "db:seed:kp-attractions": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/import-kp-attractions.ts",
    "db:seed:kp:details": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-kp-destination-details.ts",
    "db:seed:kp:turso": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-kp-to-turso.ts",
    "db:seed:hospitals": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-hospitals.ts",
    "db:seed:kptourism": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-kptourism.ts",
    "db:seed:gb-tourism": "ts-node -T --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/import-gb-tourism.ts",
    "db:sync:turso": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-local-to-turso.ts",
    "db:migrate:turso": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-turso.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.8.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@types/leaflet": "^1.9.21",
    "cloudinary": "^2.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "next": "14.1.3",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.7",
    "react-leaflet": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.4.18",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.3",
    "postcss": "^8.4.35",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "packageManager": "yarn@3.6.4+sha512.e70835d4d6d62c07be76b3c1529cb640c7443f0fe434ef4b6478a5a399218cbaf1511b396b3c56eb03bc86424cff2320f6167ad2fde273aa0df6e60b7754029f",
  "dependenciesMeta": {
    "@prisma/client@5.22.0": {
      "unplugged": true
    },
    "prisma@5.22.0": {
      "unplugged": true
    }
  }
